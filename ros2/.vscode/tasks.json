{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/learning_ws"
  },
  "tasks": [
    {
      "label": "colcon build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source /opt/ros/humble/setup.bash && colcon build --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && ros2-merge-compile-commands"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "colcon build (symlink-install)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source /opt/ros/humble/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && ros2-merge-compile-commands"
      ],
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "colcon clean (remove build/install/log)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "rm -rf build install log compile_commands.json"
      ],
      "problemMatcher": []
    },
    {
      "label": "source install/setup.bash",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "source install/setup.bash && echo 'Environment sourced OK' && env | grep -E '^ROS|^AMENT|^CMAKE_PREFIX_PATH'"
      ],
      "problemMatcher": []
    }
  ]
}
